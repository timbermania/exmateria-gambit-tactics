; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="learning"
run/main_scene="res://assets/scenes/GPUArena.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

Tune="*res://src/core/Tune.gd"
Focus="*res://src/core/Focus.gd"
UI3Registry="*res://src/ui3/UI3Registry.gd"
AssetManifest="*res://src/core/AssetManifest.gd"
UserSettings="*res://src/core/UserSettings.gd"
DebugConfig="*res://src/debug/DebugConfig.gd"
DebugOverlay="*res://src/debug/DebugOverlay.gd"
PerfMonitor="*res://src/debug/PerfMonitor.gd"
GameLogger="*res://src/debug/GameLogger.gd"
ScreenEffectOverlay="*res://addons/exmateria_effects/overlay/ScreenEffectOverlay.gd"
TintedSurfaces="*res://addons/exmateria_effects/overlay/TintedSurfaces.gd"
EventBus="*res://src/core/EventBus.gd"
CharacterCatalog="*res://addons/exmateria_catalogue/registry/CharacterCatalog.gd"
EffectMultiMeshPool="*res://addons/exmateria_effects/render/EffectMultiMeshPool.gd"
CompositorAutopilot="*res://src/effects/CompositorAutopilot.gd"
PSXDisplay="*res://addons/exmateria_platform/display_port/PSXDisplay.gd"
MasterBus="*res://src/audio/MasterBus.gd"
ExMateriaAudioEngine="*res://addons/exmateria_sound/runtime/audio_engine.gd"
MusicPlayer="*res://src/audio/MusicPlayer.gd"
ExMateriaEffectSfx="*res://addons/exmateria_sound/runtime/effect_sfx_engine.gd"
AudioHostAdapter="*res://src/audio/AudioHostAdapter.gd"
SfxRouter="*res://src/audio/SfxRouter.gd"
Campaign="*res://src/scenarios/Campaign.gd"
ScenarioLoader="*res://src/scenario/ScenarioLoader.gd"
ScenarioDebugSession="*res://src/debug/ScenarioDebugSession.gd"
SpriteRigContent="*res://src/data/SpriteRigContent.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=960
window/size/window_width_override=1024
window/size/window_height_override=960
window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"

[exmateria_battlefield]

content_root="res://assets/"

[exmateria_catalogue]

content_root="res://assets/"

[exmateria_effects]

content_root="res://assets/"

[exmateria_sprite_rig]

content_root="res://assets/"

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0
}

