[rendering]

renderer/rendering_method.mobile="forward_plus"

[shader_globals]

psx_dither_enabled={
"type": "bool",
"value": true
}
psx_gamma={
"type": "float",
"value": 1.4
}
pixel_aspect={
"type": "float",
"value": 1.0
}
psx_cursor_stretch={
"type": "float",
"value": 1.0
}
psx_fx_stretch={
"type": "float",
"value": 1.0
}
unit_stretch={
"type": "float",
"value": 1.0
}
psx_camera_angle={
"type": "int",
"value": 0
}
