[node name="ProceduralMap" parent="." instance=ExtResource("3_map")]

; The tile cursor, mounted exactly as `GambitBattle`/`GPUArena`/`EffectViewer`/`FireCastRepro`
; mount it. WITHOUT THIS NODE WASD DOES NOTHING: `PlayerCamera._execute_translation` returns
; early unless `free_camera()`, and the lab boots in CURSOR mode -- where WASD is the CURSOR's
; walk and the camera merely follows it. A lab with no cursor is a lab you cannot pan.
[node name="TileCursor" parent="." instance=ExtResource("4_tile_cursor")]
procedural_map_path = NodePath("../ProceduralMap")
player_camera_path = NodePath("../PlayerCamera")

